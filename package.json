{
  "name": "ishita-hrms",
  "version": "0.1.1",
  "description": "Ishita HRMS - local face-attendance & payroll desktop app",
  "author": "Ishita Industries",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5174 && cross-env NODE_ENV=development electron .",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder",
    "build:win": "npm run build:renderer && electron-builder --win",
    "publish": "npm run build:renderer && electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "lucide-react": "^1.47.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "jimp": "^1.6.1",
    "png-to-ico": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.ishita.hrms",
    "productName": "Ishita HRMS",
    "directories": {
      "output": "release"
    },
    "artifactName": "IshitaHRMS-Setup-${version}.${ext}",
    "files": [
      "electron/**/*",
      "dist/**/*",
      "sql/**/*",
      "build/icon.png"
    ],
    "extraResources": [
      "sql/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ishita HRMS",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "bhargav-13",
        "repo": "ishita-hrms",
        "private": false,
        "releaseType": "release"
      }
    ]
  }
}
